[Unit]
Description=Sunlite relay controller
Documentation=file:/opt/sunlite-scheduler/current/docs/deployment.md
After=local-fs.target
ConditionPathExists=/etc/sunlite-scheduler/config.toml
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=sunlite-controller
Group=sunlite
WorkingDirectory=/var/lib/sunlite-scheduler
ExecStartPre=/opt/sunlite-scheduler/current/.venv/bin/sunlite-maintenance check --config /etc/sunlite-scheduler/config.toml
ExecStart=/opt/sunlite-scheduler/current/.venv/bin/sunlite-controller --config /etc/sunlite-scheduler/config.toml
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=20s
UMask=0027
StateDirectory=sunlite-scheduler
StateDirectoryMode=0750
RuntimeDirectory=sunlite-scheduler
RuntimeDirectoryMode=0750
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=GPIOZERO_PIN_FACTORY=lgpio

NoNewPrivileges=true
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
TasksMax=64

[Install]
WantedBy=multi-user.target
