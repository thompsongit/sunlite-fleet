SUNLITE_ACCESS_REQUIRED=true
SUNLITE_CF_TEAM_DOMAIN=https://replace-with-team.cloudflareaccess.com
SUNLITE_CF_AUDIENCE=replace-with-access-aud-tag
SUNLITE_SESSION_SECRET=__GENERATE__
SUNLITE_ADMIN_EMAILS=replace-with-admin@example.com
SUNLITE_OPERATOR_EMAILS=replace-with-operator@example.com
SUNLITE_COOKIE_SECURE=true
SUNLITE_ALLOWED_HOSTS=replace-with-public-hostname,127.0.0.1,localhost
SUNLITE_CONTROLLER_SOCKET=/run/sunlite-scheduler/controller.sock
